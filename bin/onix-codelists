#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Compiles EDItEUR's ONIX code lists (the JSON or XML file you downloaded from
 * https://www.editeur.org/14/Code-Lists/) into a PHP file that
 * ArrayCodeLists::fromPhpFile() loads quickly.
 *
 *   vendor/bin/onix-codelists ONIX_BookProduct_Codelists_Issue_75.json var/onix-codelists.php
 */

use ISBNLab\Onix\CodeList\EditeurCodeLists;
use ISBNLab\Onix\Exception\OnixException;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

$arguments = array_slice($argv, 1);
if (2 !== count($arguments) || in_array($arguments[0], ['-h', '--help'], true)) {
    fwrite(STDERR, "Usage: onix-codelists <EDItEUR code list .json or .xml> <output .php>\n\n"
        . "Download the code lists from https://www.editeur.org/14/Code-Lists/ first.\n");
    exit(2);
}
[$source, $target] = $arguments;

try {
    $codeLists = EditeurCodeLists::fromFile($source);
} catch (OnixException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

$lists = $codeLists->toArray();
$issue = $codeLists->issue();
$php = "<?php\n\n"
    . '// ONIX for Books code lists, Issue ' . ($issue ?? 'unknown') . ", (c) EDItEUR (https://www.editeur.org/).\n"
    . "// Used under EDItEUR's licence, https://doi.org/10.4400/nwgj. Generated by isbnlab/onix from\n"
    . '// ' . basename($source) . "; regenerate it when EDItEUR publishes a new issue.\n\n"
    . 'return ' . var_export(['issue' => $issue, 'lists' => $lists], true) . ";\n";

if (false === @file_put_contents($target, $php)) {
    fwrite(STDERR, sprintf("Could not write %s\n", $target));
    exit(1);
}
$codes = array_sum(array_map('count', $lists));
fwrite(STDOUT, sprintf("Wrote %d code lists (%d codes, issue %s) to %s\n", count($lists), $codes, $issue ?? 'unknown', $target));
