{
    "name": "isbnlab/onix",
    "description": "Streaming ONIX for Books reader for PHP: ONIX 3.0/3.1 and 2.1, reference and short tags, typed read-only products, constant memory on multi-GB feeds.",
    "type": "library",
    "keywords": ["onix", "onix-for-books", "onix-3", "onix-2.1", "editeur", "book-metadata", "isbn", "publishing", "xml", "parser", "streaming"],
    "homepage": "https://github.com/isbnlab/isbnlab-onix-php",
    "license": "MIT",
    "authors": [
        {"name": "ISBNLab", "email": "hello@isbnlab.com", "homepage": "https://www.isbnlab.com"}
    ],
    "support": {
        "issues": "https://github.com/isbnlab/isbnlab-onix-php/issues",
        "source": "https://github.com/isbnlab/isbnlab-onix-php"
    },
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-xmlreader": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-zlib": "Read gzip-compressed feeds (.xml.gz) directly"
    },
    "autoload": {
        "psr-4": {"ISBNLab\\Onix\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"ISBNLab\\Onix\\Tests\\": "tests/"}
    },
    "bin": ["bin/onix-codelists"],
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
